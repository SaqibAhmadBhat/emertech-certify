# ===================================================
# Emertech Certify: Clean-Room v2.0 Environment Configuration
# Lead Architect: Saqib Ahmad Bhat
# Institution: Government College of Engineering, Tirunelveli
# ===================================================

# Server Port
PORT=5001

# Runtime Environment
NODE_ENV=development

# MongoDB Connection URI (auto in-memory fallback server if unreachable)
MONGO_URI=mongodb://127.0.0.1:27017/emertech_certify_cleanroom

# JWT Authentication Secret Key (REQUIRED in production: min 32 chars)
JWT_SECRET=replace_with_secure_random_jwt_secret_min_32_characters

# JWT Expiration
JWT_EXPIRES_IN=24h

# Blockchain JSON-RPC Endpoint (Local Hardhat Node or Ethereum Testnet)
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545

# Deployed EmertechCertificateRegistry Contract Address
CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# Ethereum Signer Private Key (OPTIONAL for local Hardhat node with unlocked signers)
# NEVER commit or use real private keys here
DEPLOYER_PRIVATE_KEY=your_deployer_private_key_placeholder

# Optional: Pinata IPFS Credentials (local filesystem fallback used if blank)
PINATA_API_KEY=your_pinata_api_key_optional
PINATA_SECRET_KEY=your_pinata_secret_key_optional

