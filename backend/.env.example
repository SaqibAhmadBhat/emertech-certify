# Server Port (Port 5001 avoids conflict with macOS AirPlay receiver on port 5000)
PORT=5001

# Frontend URL (for QR code verification links)
FRONTEND_URL=http://localhost:3000

# MongoDB Connection URI
# Leave blank or use default for automatic in-memory MongoDB demonstration fallback
MONGO_URI=mongodb://127.0.0.1:27017/emertech_certify

# JWT Authentication Secret Key
JWT_SECRET=emertech_certify_secure_jwt_secret_academic_demo_2026

# Administrator Account Credentials (used for institutional approval & governance)
ADMIN_EMAIL=admin@emertech.local
ADMIN_PASSWORD=admin123

# Optional: Pinata IPFS Decentralized Storage API Credentials
# If omitted or left as placeholders, the system uses the local storage fallback automatically
PINATA_API_KEY=your_pinata_api_key_optional
PINATA_API_SECRET=your_pinata_api_secret_optional

# Blockchain Integration (Local Hardhat Node or Ethereum Testnet)
# Default localhost RPC URL provided by: npx hardhat node
RPC_URL=http://127.0.0.1:8545

# Hardhat Account #0 standard development private key (NEVER use with real mainnet funds)
ETH_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# Deployed CertificateRegistry Smart Contract Address (from `npm run deploy:localhost`)
CONTRACT_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3
