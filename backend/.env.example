# ===================================================
# Emertech Certify: Environment Configuration Template (v1 Historical)
# Developer: Saqib Ahmad Bhat
# Institution: Government College of Engineering, Tirunelveli
# ===================================================

# Server Port (Port 5001 avoids conflict with macOS AirPlay receiver on port 5000)
PORT=5001

# Frontend URL (for QR code verification links)
FRONTEND_URL=http://localhost:3000

# MongoDB Connection URI (auto in-memory fallback if unreachable)
MONGO_URI=mongodb://127.0.0.1:27017/emertech_certify

# JWT Authentication Secret Key (replace with secure random string in production)
JWT_SECRET=replace_with_secure_random_jwt_secret_min_32_characters

# Administrator Account Credentials (used for initial setup)
ADMIN_EMAIL=admin@example.local
ADMIN_PASSWORD=replace_with_secure_admin_password

# Optional: Pinata IPFS Decentralized Storage API Credentials
PINATA_API_KEY=your_pinata_api_key_optional
PINATA_API_SECRET=your_pinata_api_secret_optional

# Blockchain Integration (Local Hardhat Node or Ethereum Testnet)
RPC_URL=http://127.0.0.1:8545

# Ethereum Signer Private Key (PLACEHOLDER ONLY — DO NOT COMMIT REAL KEYS)
# For local Hardhat testing, omit or provide local testnet private key
ETH_PRIVATE_KEY=your_ethereum_private_key_placeholder

# Deployed CertificateRegistry Smart Contract Address
CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
